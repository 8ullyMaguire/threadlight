# Copy to .env and fill in. NEVER commit a real .env -- this file is the only one
# that belongs in the repository, and it carries placeholders rather than values.
#
# The integration suite reads DATABASE_URL. Without it, `cargo test --test '*'`
# falls back to postgres://postgres@localhost/threadlight_test, which does not exist
# on this host -- so the suite cannot run and has no recorded passing run.
#
# Provision the database first; the script is idempotent and prints the DSN:
#     ./scripts/provision-test-db.sh
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:55433/threadlight_test?sslmode=disable

# Where the app reads its own database from in development (src/config.rs:22).
APP_DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:55433/threadlight?sslmode=disable
